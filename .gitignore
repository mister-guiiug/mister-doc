# Test / build artifacts
coverage
dev-dist
*.tsbuildinfo

# JS émis par erreur à côté des sources TS (un `tsc` sans --noEmit, ex. quand
# node_modules est incomplet). Ces fichiers cassent le lint ET le build : Vite
# charge `vite.config.js` au lieu du `.ts`. Ignorés pour ne jamais être commités.
src/**/*.js
src/**/*.jsx
/vite.config.js
/vitest.config.js

# Cache local du CLI Supabase (ref du projet liée à la machine).
supabase/.temp

# Playwright (E2E)
test-results
playwright-report
blob-report
e2e/test-results
e2e/playwright-report

# Lighthouse CI (rapports locaux)
.lighthouseci/

# Copies complètes du dépôt, créées par les agents lancés en `isolation:
# worktree`. Elles étaient masquées par `.git/info/exclude`, qui est LOCAL :
# invisible à `git status` ici, absent partout ailleurs. Versionnée, la ligne
# couvre aussi Prettier, qui honore `.gitignore` depuis la 3.x.
.claude/worktrees/
