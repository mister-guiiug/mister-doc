{
  "name": "mister-doc",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "mister-doc — PWA de synchronisation du planning de gardes des médecins d'un hôpital. Vue mensuelle des créneaux, authentification Supabase, compteurs week-end et heures par médecin.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "preview": "vite preview --base /mister-doc/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm --prefix e2e test",
    "type-check": "tsc -b",
    "icons": "pwa-icons --source public/favicon.svg --out public/icons --sizes 192,512 --no-apple",
    "icons:maskable": "node scripts/generate-maskable.mjs",
    "prepare": "husky || true"
  },
  "bundleBudget": {
    "totalGzipKb": 264
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^4.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
